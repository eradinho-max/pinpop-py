  "icons": [
    {
      "src": "/images/brand/pinpop-logo-web.png",
      "sizes": "any",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/images/brand/pinpop-logo-web.png",
      "sizes": "any",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}