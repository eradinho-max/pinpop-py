{
  "name": "PINPOP Admin",
  "short_name": "PINPOP Admin",
  "description": "Administración privada de catálogo, stock y pedidos PINPOP.",
  "id": "/admin",
  "start_url": "/admin",
  "scope": "/admin",
  "display": "standalone",
